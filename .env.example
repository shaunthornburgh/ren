# Copy to `.env` and fill in your Stripe test-mode values.
# docker-compose reads this file automatically for ${VAR} substitution.

# Stripe test-mode API keys (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Webhook signing secret. For local dev, run:
#   stripe listen --forward-to localhost:8000/api/v1/payments/webhook
# and copy the `whsec_...` value it prints.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ISO 4217 currency for Checkout line items (lowercase).
STRIPE_CURRENCY=usd

# --- Email / SMTP ---
# Leave EMAIL_ENABLED=false for local dev: emails are written to the backend
# log (console backend) instead of being sent. Set it to true and fill in a
# real SMTP relay (e.g. Mailgun/Resend SMTP) to actually send.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAILS_FROM_EMAIL=no-reply@ren.local
EMAILS_FROM_NAME=Ren

# Public base URL of the frontend, used to build links in emails.
FRONTEND_URL=http://localhost:3000

# --- Google Maps (frontend, browser key) ---
# Passed to the frontend container as NUXT_PUBLIC_GOOGLE_MAPS_API_KEY.
#
# This key is served to the browser and cannot be hidden — restrict it in
# Google Cloud Console rather than treating it as a secret:
#   * Application restriction: HTTP referrers →
#       http://localhost:3000/*  plus your production domain
#   * API restriction: allow ONLY
#       Places API (New)     — autocomplete in the organizer event form
#       Maps JavaScript API  — loads the autocomplete widget
#       Maps Embed API       — the map on the public event page
# Use a separate, referrer-free key for any server-side Maps calls.
GOOGLE_MAPS_API_KEY=
